---
layout: null
---
{%- assign listed_posts = site.posts | where_exp: "post", "post.listed != false" -%}
{
  "schema": "bibliothecarius.editions-index/1",
  "generated_at": "{{ site.time | date_to_xmlschema }}",
  "publisher": {"name": "Bibliothecarius Modernus", "url": "{{ site.url }}", "identity": {{ site.identity | jsonify }}},
  "rights": {"license": "CC0-1.0", "license_url": "https://creativecommons.org/publicdomain/zero/1.0/", "note": "This index, the translations, essays and metadata it points to are dedicated CC0 1.0 by Bibliothecarius Modernus; Latin source texts are public domain (Migne, Patrologia Latina) and are not redistributed here."},
  "catalog": "{{ site.url }}/api/catalog.json",
  "posts": [
    {% for post in listed_posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": "{{ site.url }}{{ site.baseurl }}{{ post.url }}",
      "date": "{{ post.date | date_to_xmlschema }}",
      "categories": [{% for category in post.categories %}"{{ category }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
      "original_work": {
        "latin_title": {% if post.original_work.latin_title %}{{ post.original_work.latin_title | jsonify }}{% else %}null{% endif %},
        "author": {% if post.original_work.author %}{{ post.original_work.author | jsonify }}{% else %}null{% endif %},
        "date": {% if post.original_work.date %}{{ post.original_work.date | jsonify }}{% else %}null{% endif %},
        "publication": {% if post.original_work.publication %}{{ post.original_work.publication | jsonify }}{% else %}null{% endif %}
        {% if post.original_work.context %},
        "context": {{ post.original_work.context | jsonify }}
        {% endif %}
      },
      "catalog_id": {% if post.catalog_id %}{{ post.catalog_id | jsonify }}{% else %}null{% endif %},
      "pl_volume": {% if post.pl_volume %}{{ post.pl_volume | jsonify }}{% else %}null{% endif %},
      "pl_columns": {% if post.pl_columns %}{{ post.pl_columns | jsonify }}{% else %}null{% endif %},
      "project_id": {% if post.project_id %}{{ post.project_id | jsonify }}{% else %}null{% endif %},
      "youtube_id": {% if post.youtube_id %}{{ post.youtube_id | jsonify }}{% else %}null{% endif %},
      "youtube_url": {% if post.youtube_id %}"https://www.youtube.com/watch?v={{ post.youtube_id }}"{% else %}null{% endif %},
      "external_resources": {
        "archive_url": {% if post.external_resources.archive_url %}{{ post.external_resources.archive_url | jsonify }}{% else %}null{% endif %},
        "github_url": {% if post.external_resources.github_url %}{{ post.external_resources.github_url | jsonify }}{% else %}null{% endif %},
        "doi": {% if post.external_resources.doi %}{{ post.external_resources.doi | jsonify }}{% else %}null{% endif %}
      }
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
