---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment -%}
  Hand-written sitemap (overrides jekyll-sitemap's generated file, which listed
  unlisted posts). Includes real HTML pages and listed posts only; redirect
  stubs, feeds, JSON, the 404 page and posts with `listed: false` are omitted.
  {%- endcomment -%}
  {%- for page in site.pages %}
    {%- assign last_char = page.url | slice: -1 %}
    {%- if page.sitemap == false or page.redirect_to %}{% continue %}{% endif %}
    {%- if page.url contains "404" %}{% continue %}{% endif %}
    {%- unless last_char == "/" or page.url contains ".html" %}{% continue %}{% endunless %}
  <url>
    <loc>{{ page.url | replace: 'index.html', '' | absolute_url }}</loc>
  </url>
  {%- endfor %}
  {%- for post in site.posts %}
    {%- if post.listed == false %}{% continue %}{% endif %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {%- endfor %}
</urlset>
